{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\$[A-Z]",
      "end": "^\\$END"
    }
  },
  "wordPattern": "\\$?[a-zA-Z_][a-zA-Z0-9_]*|[-+]?[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?"
}
